# --- Database (PostgreSQL) ---------------------------------------------------
# Free hosted option: https://neon.tech  (copy the connection string here)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/suraksha?sslmode=require"

# --- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the site (http://localhost:3000 in development)
NEXTAUTH_URL="http://localhost:3000"

# --- Admin account created by `npm run db:seed` --------------------------------
SEED_ADMIN_EMAIL="admin@surakshaandc.com"
# At least 12 characters
SEED_ADMIN_PASSWORD=""
