# --- Database (PostgreSQL) ---------------------------------------------------
# Free hosted option: https://neon.tech  (copy the connection string here)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/suraksha?sslmode=require"

# --- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the site (http://localhost:3000 in development)
NEXTAUTH_URL="http://localhost:3000"

# --- Node.js hosting / WebSocket server ----------------------------------------
# npm run dev and npm start serve HTTP and WebSockets on the same port.
PORT=3000
HOST="0.0.0.0"
# Set NEXTAUTH_URL to the public HTTPS origin in production (WebSocket origin check).
# If DATABASE_URL uses PgBouncer transaction pooling, provide a direct PostgreSQL
# connection here: LISTEN requires a persistent session. Otherwise leave unset.
# REALTIME_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/suraksha?sslmode=require"

# The admin login is set in prisma/seed.ts (ADMIN_EMAIL / ADMIN_PASSWORD).
